<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="@color/surface_focus" /><corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="@color/accent" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="@color/surface_focus" /><corners android:radius="8dp" /></shape>
    </item>
    <item android:state_activated="true">
        <shape><solid android:color="#FF24364A" /><corners android:radius="8dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/surface" /><corners android:radius="8dp" /></shape>
    </item>
</selector>
